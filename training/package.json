{
  "name": "catan-helper-training",
  "description": "Synthetic dataset generation and model training for the Catan Helper extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "assets": "node --import tsx src/fetch-assets.ts",
    "preview": "node --require ./tfjs-node-compat.cjs --import tsx src/preview.ts",
    "train": "node --require ./tfjs-node-compat.cjs --import tsx src/train.ts",
    "typecheck": "tsc --noEmit",
    "locate": "node --import tsx src/locate.ts",
    "extract-tiles": "node --import tsx src/extract-tiles.ts",
    "train:pieces": "node --require ./tfjs-node-compat.cjs --import tsx src/train-pieces.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.60",
    "@tensorflow/tfjs-node": "4.22.0",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  }
}
