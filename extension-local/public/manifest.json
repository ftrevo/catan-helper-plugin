{
  "manifest_version": 3,
  "name": "Catan Helper",
  "version": "2.0.0",
  "description": "A helper tool for Catan games on colonist.io. Reads the board on-device, no server involved.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Catan Helper"
  },
  "permissions": ["activeTab", "storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Catan Helper"
    }
  }
}
