{
  "name": "catan-helper-back",
  "version": "1.0.0",
  "description": "Catan helper plugin backend",
  "main": "src/main.js",
  "author": "Felipe Trevisan",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build --tsc -- -b",
    "check-types": "tsc -p ./tsconfig.build.json --noEmit",
    "start": "dotenvx run -- nest start",
    "start:prod": "node dist/src/main.js",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@tensorflow/tfjs-node": "^4.22.0",
    "nestjs-pino": "^4.4.1",
    "nestjs-zod": "^5.0.1",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.51.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/testing": "^11.1.6",
    "@suites/di.nestjs": "3.0.1",
    "@types/express": "^5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "^24.7.0",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "30.2.0",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.7.4",
    "prisma": "^6.17.0",
    "supertest": "^7.1.4",
    "ts-jest": "29.4.5",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
